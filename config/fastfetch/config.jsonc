{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.local/share/chiroptera/branding/fastfetch-logo.png",
    "type": "sixel",
    "width": 34,
    "height": 17,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    },
    "recache": true
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "cyan",
      "title": "cyan"
    },
    "key": {
      "width": 13
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌──────────┐"
    },
    {
      "type": "title",
      "key": "│ 󰀄 user   │",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "│ 󰇅 hname  │",
      "format": "{host-name}"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 uptime │"
    },
    {
      "type": "os",
      "key": "│ 󰣇 distro │",
      "format": "ChiropteraOS (Main) {arch}"
    },
    {
      "type": "kernel",
      "key": "│ 󰌽 kernel │"
    },
    {
      "type": "wm",
      "key": "│ 󰖲 wm     │"
    },
    {
      "type": "terminal",
      "key": "│ 󰆍 term   │"
    },
    {
      "type": "shell",
      "key": "│ 󱆃 shell  │"
    },
    {
      "type": "cpu",
      "key": "│ 󰻠 cpu    │"
    },
    {
      "type": "disk",
      "key": "│ 󰋊 disk   │",
      "folders": "/"
    },
    {
      "type": "memory",
      "key": "│ 󰑭 memory │"
    },
    {
      "type": "custom",
      "format": "└──────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "PC"
    },
    {
      "type": "gpu",
      "key": " ├ 󰢮 gpu"
    },
    {
      "type": "swap",
      "key": " ├ 󰓡 swap"
    },
    {
      "type": "display",
      "key": " ├ 󰍹 disp",
      "compactType": "original"
    },
    {
      "type": "datetime",
      "key": " └ 󰃭 dtime",
      "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}"
    },
    {
      "type": "colors",
      "key": "   󰏘 colors",
      "symbol": "circle",
      "paddingLeft": 0
    }
  ]
}
