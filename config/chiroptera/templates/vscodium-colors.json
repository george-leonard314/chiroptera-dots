    "tab.activeForeground": "{{colors.primary.default.hex}}",
    "tab.inactiveForeground": "{{colors.on_surface_variant.default.hex}}",
    "tab.activeBorderTop": "{{colors.primary.default.hex}}",
    "sideBar.background": "{{colors.surface_container_low.default.hex}}",
    "sideBar.foreground": "{{colors.on_surface_variant.default.hex}}",
    "sideBar.border": "{{colors.outline_variant.default.hex}}",
    "sideBarTitle.foreground": "{{colors.on_surface.default.hex}}",
    "sideBarSectionHeader.background": "{{colors.surface_container.default.hex}}",
    "activityBar.background": "{{colors.surface_container_lowest.default.hex}}",
    "activityBar.foreground": "{{colors.primary.default.hex}}",
    "activityBar.inactiveForeground": "{{colors.outline.default.hex}}",
    "activityBarBadge.background": "{{colors.primary.default.hex}}",
    "activityBarBadge.foreground": "{{colors.on_primary.default.hex}}",
    "statusBar.background": "{{colors.surface_container.default.hex}}",
    "statusBar.foreground": "{{colors.on_surface_variant.default.hex}}",
    "statusBar.noFolderBackground": "{{colors.surface_container.default.hex}}",
    "statusBar.debuggingBackground": "{{colors.tertiary_container.default.hex}}",
    "titleBar.activeBackground": "{{colors.surface_container_lowest.default.hex}}",
    "titleBar.activeForeground": "{{colors.on_surface.default.hex}}",
    "titleBar.inactiveBackground": "{{colors.surface_container_lowest.default.hex}}",
    "panel.background": "{{colors.surface_container_low.default.hex}}",
    "panel.border": "{{colors.outline_variant.default.hex}}",
    "panelTitle.activeForeground": "{{colors.primary.default.hex}}",
    "panelTitle.activeBorder": "{{colors.primary.default.hex}}",
    "terminal.background": "{{colors.terminal_background.default.hex}}",
    "terminal.foreground": "{{colors.terminal_foreground.default.hex}}",
    "terminal.ansiBlack": "{{colors.terminal_normal_black.default.hex}}",
    "terminal.ansiRed": "{{colors.terminal_normal_red.default.hex}}",
    "terminal.ansiGreen": "{{colors.terminal_normal_green.default.hex}}",
    "terminal.ansiYellow": "{{colors.terminal_normal_yellow.default.hex}}",
    "terminal.ansiBlue": "{{colors.terminal_normal_blue.default.hex}}",
    "terminal.ansiMagenta": "{{colors.terminal_normal_magenta.default.hex}}",
    "terminal.ansiCyan": "{{colors.terminal_normal_cyan.default.hex}}",
    "terminal.ansiWhite": "{{colors.terminal_normal_white.default.hex}}",
    "terminal.ansiBrightBlack": "{{colors.terminal_bright_black.default.hex}}",
    "terminal.ansiBrightRed": "{{colors.terminal_bright_red.default.hex}}",
    "terminal.ansiBrightGreen": "{{colors.terminal_bright_green.default.hex}}",
    "terminal.ansiBrightYellow": "{{colors.terminal_bright_yellow.default.hex}}",
    "terminal.ansiBrightBlue": "{{colors.terminal_bright_blue.default.hex}}",
    "terminal.ansiBrightMagenta": "{{colors.terminal_bright_magenta.default.hex}}",
    "terminal.ansiBrightCyan": "{{colors.terminal_bright_cyan.default.hex}}",
    "terminal.ansiBrightWhite": "{{colors.terminal_bright_white.default.hex}}",
    "input.background": "{{colors.surface_container.default.hex}}",
    "input.foreground": "{{colors.on_surface.default.hex}}",
    "input.border": "{{colors.outline_variant.default.hex}}",
    "focusBorder": "{{colors.primary.default.hex}}",
    "button.background": "{{colors.primary.default.hex}}",
    "button.foreground": "{{colors.on_primary.default.hex}}",
    "list.activeSelectionBackground": "{{colors.primary_container.default.hex}}",
    "list.activeSelectionForeground": "{{colors.on_primary_container.default.hex}}",
    "list.hoverBackground": "{{colors.surface_container_high.default.hex}}",
    "list.highlightForeground": "{{colors.primary.default.hex}}",
    "dropdown.background": "{{colors.surface_container.default.hex}}",
    "menu.background": "{{colors.surface_container.default.hex}}",
    "editorWidget.background": "{{colors.surface_container.default.hex}}",
    "editorError.foreground": "{{colors.error.default.hex}}",
    "badge.background": "{{colors.primary.default.hex}}",
    "badge.foreground": "{{colors.on_primary.default.hex}}",
    "scrollbarSlider.background": "{{colors.outline_variant.default.hex}}80",
    "progressBar.background": "{{colors.primary.default.hex}}",
    "textLink.foreground": "{{colors.tertiary.default.hex}}"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{colors.outline.default.hex}}", "fontStyle": "italic" } },
      { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "{{colors.primary.default.hex}}" } },
      { "scope": ["string", "string.quoted"], "settings": { "foreground": "{{colors.terminal_normal_green.default.hex}}" } },
      { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "{{colors.secondary.default.hex}}" } },
      { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "{{colors.tertiary.default.hex}}" } },
      { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "{{colors.secondary.default.hex}}" } },
      { "scope": ["variable", "variable.other"], "settings": { "foreground": "{{colors.on_surface.default.hex}}" } },
      { "scope": ["variable.parameter", "variable.other.property", "meta.object-literal.key"], "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" } },
      { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" } },
      { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "{{colors.error.default.hex}}" } }
    ]
  }
}
